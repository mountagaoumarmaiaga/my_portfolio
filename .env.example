# ---------------------------------------------------------------------------
# Contact form — server side (preferred)
# ---------------------------------------------------------------------------
# With these set, /api/contact sends through Resend and no key ever reaches the
# browser. Leave them unset and the route replies { configured: false }, which
# makes the form fall back to EmailJS.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=portfolio@your-verified-domain.com
CONTACT_TO_EMAIL=mountagaoumarmaiga@gmail.com

# ---------------------------------------------------------------------------
# Contact form — client fallback
# ---------------------------------------------------------------------------
# EmailJS is public-key by design, so these are safe to expose. They are the
# only NEXT_PUBLIC_ values in the project.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
